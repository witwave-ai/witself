.git
.github

# Local build outputs and dependency caches are not needed by the container
# builds. Keeping them out of the Wrangler context makes control-plane deploys
# much less likely to fail while streaming the build context to Docker.
bin
dist
coverage
*.cover
*.test

node_modules
infra/cloudflare/control-plane/node_modules
infra/pulumi/bin

# Private Wrangler snapshots are siblings of the two Worker source trees.
# Exclude their actual repo-relative paths so their unpredictable directory
# names cannot invalidate the control-plane container's COPY/build cache.
infra/cloudflare/witself-control-plane-deploy-*/
infra/cloudflare/witself-agent-email-deploy-*/
infra/cloudflare/witself-relay-control-plane-*/
infra/cloudflare/witself-relay-email-edge-*/
