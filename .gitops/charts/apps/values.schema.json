{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "egressHostCIDR": {
      "type": "string",
      "description": "Exact hosts (/32 IPv4, /128 IPv6) are preferred where stable; provider ranges are acceptable for anycast-fronted services. Require IPv4 /16 or narrower, or IPv6 /32 or narrower.",
      "pattern": "^((?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[6-9]|2[0-9]|3[0-2])|(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:)|(?:[0-9A-Fa-f]{1,4}:){1,6}(?::[0-9A-Fa-f]{1,4}){1,1}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|(?:[0-9A-Fa-f]{1,4}:){1,1}(?::[0-9A-Fa-f]{1,4}){1,6})/(?:3[2-9]|[4-9][0-9]|1[01][0-9]|12[0-8]))$"
    }
  },
  "properties": {
    "egressPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "controlPlaneCIDRs",
        "r2CIDRs",
        "agentEmailCIDRs",
        "stripeCIDRs"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controlPlaneCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "$ref": "#/definitions/egressHostCIDR"
          }
        },
        "r2CIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "$ref": "#/definitions/egressHostCIDR"
          }
        },
        "agentEmailCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "$ref": "#/definitions/egressHostCIDR"
          }
        },
        "stripeCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "$ref": "#/definitions/egressHostCIDR"
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "properties": {
        "witselfServer": {
          "type": "object",
          "properties": {
            "imageDigest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "civoPostgres": {
          "type": "object",
          "properties": {
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule",
                "activeDeadlineSeconds",
                "legacyImage",
                "image",
                "ageRecipientSecretName",
                "r2SecretName"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 9
                },
                "activeDeadlineSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 7200
                },
                "legacyImage": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "repository": {
                          "type": "string",
                          "pattern": "^([a-z0-9]+([.-][a-z0-9]+)*(:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*$|^$"
                        },
                        "tag": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$|^$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^(sha256:[a-f0-9]{64})?$"
                        }
                      },
                      "anyOf": [
                        {
                          "properties": {
                            "repository": { "const": "" },
                            "tag": { "const": "" },
                            "digest": { "const": "" }
                          }
                        },
                        {
                          "required": ["repository", "tag"],
                          "properties": {
                            "repository": { "minLength": 1 },
                            "tag": { "minLength": 1 }
                          }
                        }
                      ]
                    }
                  ]
                },
                "ageRecipientSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "r2SecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
