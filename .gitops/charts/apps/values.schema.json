{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "apps": {
      "type": "object",
      "properties": {
        "witselfServer": {
          "type": "object",
          "properties": {
            "imageDigest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "civoPostgres": {
          "type": "object",
          "properties": {
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "schedule",
                "activeDeadlineSeconds",
                "legacyImage",
                "image",
                "ageRecipientSecretName",
                "r2SecretName"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "schedule": {
                  "type": "string",
                  "minLength": 9
                },
                "activeDeadlineSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 7200
                },
                "legacyImage": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "repository": {
                          "type": "string",
                          "pattern": "^([a-z0-9]+([.-][a-z0-9]+)*(:[0-9]+)?/)?[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*(/[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*)*$|^$"
                        },
                        "tag": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$|^$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^(sha256:[a-f0-9]{64})?$"
                        }
                      },
                      "anyOf": [
                        {
                          "properties": {
                            "repository": { "const": "" },
                            "tag": { "const": "" },
                            "digest": { "const": "" }
                          }
                        },
                        {
                          "required": ["repository", "tag"],
                          "properties": {
                            "repository": { "minLength": 1 },
                            "tag": { "minLength": 1 }
                          }
                        }
                      ]
                    }
                  ]
                },
                "ageRecipientSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "r2SecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                }
              }
            }
          }
        }
      }
    }
  }
}
