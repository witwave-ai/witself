{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "object",
      "properties": {
        "monitoring": {
          "type": "object",
          "properties": {
            "postgresBackupAlerts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Opt in to encrypted PostgreSQL backup failure and staleness rules when the scheduled backup and monitoring stack are enabled. This does not enable the monitoring stack or external alert delivery."
                }
              }
            }
          }
        }
      }
    }
  }
}
