# macOS / OS
.DS_Store
Thumbs.db

# Editors
*.swp
*~
.idea/
.vscode/

# Agent-runtime scaffolding that delegation launchers and headless agents write
# into a worktree (per-worktree permission files, project-local config). None of
# it is project source, and a linked worktree ignores its own info/exclude, so a
# `git add -A` would otherwise commit it. .claude/ is project-owned and stays
# tracked.
.cursor/
.grok/
.codex/
.dsh/

# Go (implementation to come — see docs/scaffold-readiness.md)
/bin/
/dist/
*.test
*.out
coverage.*

# Local env / credentials (never commit)
.env
*.local
*.tfvars
*.token

# Local dev (compose.yaml) and chart packaging output
.dev/
dist-charts/
.wrangler/

# stray local go build outputs (binaries build into ./bin via make build)
/witself
/witself-admin
/witself-tui
/witself-server
/ws

# Nested Pulumi module build outputs.
/infra/pulumi/witself-infra
/infra/pulumi/cmd/witself-infra/witself-infra
# Local acceptance evidence (make dashboard-acceptance); CI uploads its own copy.
evidence/
