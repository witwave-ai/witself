{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witself.witwave.ai/schemas/memory-relevance-result.v1.schema.json",
  "title": "Witself synthetic lexical relevance evidence v1",
  "description": "Measured top-K relevance on a frozen synthetic corpus; no quality threshold or production readiness claim. The Go validator additionally binds the corpus digest, complete case order, gold counts, and exact metric formulas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "harness_version",
    "started_at",
    "completed_at",
    "outcome",
    "postgresql_version",
    "environment",
    "fixture_clock",
    "recall_as_of",
    "corpus_sha256",
    "corpus_memories",
    "query_count",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "witself.memory-relevance-result.v1"
    },
    "harness_version": {
      "const": "1"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "const": "measured"
    },
    "postgresql_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]?(\\.[0-9]{1,2}){0,2}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "commit",
        "provider",
        "hardware_tier",
        "go_version",
        "goos",
        "goarch",
        "logical_cpus"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/safe_metadata"
        },
        "commit": {
          "$ref": "#/$defs/safe_metadata"
        },
        "provider": {
          "$ref": "#/$defs/safe_label"
        },
        "hardware_tier": {
          "$ref": "#/$defs/safe_label"
        },
        "go_version": {
          "type": "string",
          "pattern": "^go1\\.[0-9]{1,2}(\\.[0-9]{1,2}|(rc|beta)[0-9]{1,2})?$"
        },
        "goos": {
          "enum": [
            "aix",
            "android",
            "darwin",
            "dragonfly",
            "freebsd",
            "hurd",
            "illumos",
            "ios",
            "js",
            "linux",
            "netbsd",
            "openbsd",
            "plan9",
            "solaris",
            "wasip1",
            "windows"
          ]
        },
        "goarch": {
          "enum": [
            "386",
            "amd64",
            "arm",
            "arm64",
            "loong64",
            "mips",
            "mipsle",
            "mips64",
            "mips64le",
            "ppc64",
            "ppc64le",
            "riscv64",
            "s390x",
            "wasm"
          ]
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fixture_clock": {
      "const": "indexed-seconds-v1"
    },
    "recall_as_of": {
      "const": "2026-01-02T00:00:00Z"
    },
    "corpus_sha256": {
      "const": "e7557789f24cb13c0b89865dbdb211248224e49a1d7ff998aeac0fa69ba88807"
    },
    "corpus_memories": {
      "const": 24
    },
    "query_count": {
      "const": 12
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "aster_seedling_watering"
                },
                "top_k": {
                  "const": 5
                },
                "relevant_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "aster_herb_watering"
                },
                "top_k": {
                  "const": 1
                },
                "relevant_count": {
                  "const": 1
                }
              }
            }
          ]
        },
        {
