                },
                "top_k": {
                  "const": 5
                },
                "relevant_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "birch_puncture_synonyms"
                },
                "top_k": {
                  "const": 3
                },
                "relevant_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "cedar_reservation_procedure"
                },
                "top_k": {
                  "const": 5
                },
                "relevant_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "cedar_capacity_no_answer"
                },
                "top_k": {
                  "const": 3
                },
                "relevant_count": {
                  "const": 0
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "dune_meeting_location"
                },
                "top_k": {
                  "const": 5
                },
                "relevant_count": {
                  "const": 2
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "dune_rain_location"
                },
                "top_k": {
                  "const": 1
                },
                "relevant_count": {
                  "const": 1
                }
              }
