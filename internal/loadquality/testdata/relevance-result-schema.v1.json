                "relevant_count": {
                  "const": 0
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "safe_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_-]{0,127}$"
    },
    "safe_metadata": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "top_k",
        "retrieved_count",
        "relevant_count",
        "relevant_ranks",
        "true_positives",
        "false_positives",
        "precision_at_k",
        "recall_at_k",
        "reciprocal_rank"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retrieved_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "relevant_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "relevant_ranks": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "true_positives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "false_positives": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "precision_at_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall_at_k": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reciprocal_rank": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
