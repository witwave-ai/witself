          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/case"
            },
            {
              "properties": {
                "name": {
                  "const": "elm_catalog_synonyms"
                },
                "top_k": {
                  "const": 3
                },
                "relevant_count": {
