{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witself.witwave.ai/schemas/memory-archive-load-result.v1.schema.json",
  "title": "Witself narrative-memory archive load result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "harness_version",
    "started_at",
    "completed_at",
    "outcome",
    "postgresql_version",
    "environment",
    "workload",
    "measurements",
    "outcomes"
  ],
  "properties": {
    "schema": { "const": "witself.memory-archive-load-result.v1" },
    "harness_version": { "const": "1" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "outcome": { "const": "pass" },
    "postgresql_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "commit",
        "provider",
        "hardware_tier",
        "go_version",
        "goos",
        "goarch",
        "logical_cpus"
      ],
      "properties": {
        "release": { "$ref": "#/$defs/safe_metadata" },
        "commit": { "$ref": "#/$defs/safe_metadata" },
        "provider": { "$ref": "#/$defs/safe_label" },
        "hardware_tier": { "$ref": "#/$defs/safe_label" },
        "go_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "goos": { "type": "string", "minLength": 1, "maxLength": 32 },
        "goarch": { "type": "string", "minLength": 1, "maxLength": 32 },
        "logical_cpus": { "type": "integer", "minimum": 1 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "synthetic_accounts",
        "synthetic_agents",
        "cardinalities",
        "versions_per_memory",
        "evidence_per_memory",
        "relations_per_memory",
        "tags_per_version",
        "transcript_share_percent",
        "transcript_entries_per_selected_memory",
        "vector_dimensions",
        "lexical_queries",
        "hybrid_queries",
        "safety_calls"
      ],
      "properties": {
        "seed": { "type": "integer" },
        "synthetic_accounts": { "type": "integer", "minimum": 3, "maximum": 6 },
        "synthetic_agents": { "type": "integer", "minimum": 5, "maximum": 11 },
        "cardinalities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 10, "maximum": 10000 }
        },
        "versions_per_memory": { "type": "integer", "minimum": 2, "maximum": 8 },
        "evidence_per_memory": { "type": "integer", "minimum": 1, "maximum": 8 },
        "relations_per_memory": { "type": "integer", "minimum": 1, "maximum": 4 },
        "tags_per_version": { "type": "integer", "minimum": 1, "maximum": 16 },
        "transcript_share_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "transcript_entries_per_selected_memory": { "type": "integer", "minimum": 1, "maximum": 8 },
        "vector_dimensions": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "lexical_queries": { "const": 2 },
        "hybrid_queries": { "const": 2 },
        "safety_calls": { "const": 4 }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardinality_ladder"],
      "properties": {
        "cardinality_ladder": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/cardinality_measurement" }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardinality_ladder",
        "vector_portability",
        "all_cardinalities_complete"
      ],
      "properties": {
        "cardinality_ladder": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/cardinality_outcome" }
        },
        "vector_portability": { "$ref": "#/$defs/vector_portability" },
        "all_cardinalities_complete": { "const": true }
      }
    }
  },
  "$defs": {
    "safe_label": {
      "type": "string",
      "description": "Operator-typed dotless label; dots are rejected so a pasted database hostname cannot be retained.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_-]{0,127}$"
    },
    "safe_metadata": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "operation_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "wall_duration_ms",
        "throughput_per_second",
        "minimum_ms",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "maximum_ms"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "wall_duration_ms": { "type": "number", "exclusiveMinimum": 0 },
        "throughput_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "minimum_ms": { "type": "number", "minimum": 0 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "p99_ms": { "type": "number", "minimum": 0 },
        "maximum_ms": { "type": "number", "minimum": 0 }
      }
    },
    "cardinality_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_count",
        "seed",
        "export",
        "verify",
        "import",
        "lexical_recall_before",
        "lexical_recall_after",
        "hybrid_recall_before",
        "hybrid_recall_after",
        "post_import_safety",
        "export_rows_per_second",
        "export_bytes_per_second",
        "import_rows_per_second",
        "import_bytes_per_second"
      ],
      "properties": {
        "memory_count": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "seed": { "$ref": "#/$defs/operation_stats" },
        "export": { "$ref": "#/$defs/operation_stats" },
        "verify": { "$ref": "#/$defs/operation_stats" },
        "import": { "$ref": "#/$defs/operation_stats" },
        "lexical_recall_before": { "$ref": "#/$defs/operation_stats" },
        "lexical_recall_after": { "$ref": "#/$defs/operation_stats" },
        "hybrid_recall_before": { "$ref": "#/$defs/operation_stats" },
        "hybrid_recall_after": { "$ref": "#/$defs/operation_stats" },
        "post_import_safety": { "$ref": "#/$defs/operation_stats" },
        "export_rows_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "export_bytes_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "import_rows_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "import_bytes_per_second": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "table_rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exported", "verified", "imported"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "exported": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "imported": { "type": "integer", "minimum": 0 }
      }
    },
    "focal_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memories",
        "memory_versions",
        "memory_evidence",
        "memory_relations",
        "transcript_conversations",
        "transcript_entries",
        "memory_vector_profiles",
        "memory_vectors",
        "tag_assignments"
      ],
      "properties": {
        "memories": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "memory_versions": { "type": "integer", "minimum": 20, "maximum": 80000 },
        "memory_evidence": { "type": "integer", "minimum": 10, "maximum": 80000 },
        "memory_relations": { "type": "integer", "minimum": 10, "maximum": 40000 },
        "transcript_conversations": { "const": 1 },
        "transcript_entries": { "type": "integer", "minimum": 1, "maximum": 80000 },
        "memory_vector_profiles": { "const": 1 },
        "memory_vectors": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "tag_assignments": { "type": "integer", "minimum": 20, "maximum": 1280000 }
      }
    },
    "recall_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "before_hits",
        "after_hits",
        "ranked_ids_identical",
        "score_components_exact",
        "metadata_exact"
      ],
      "properties": {
        "name": {
          "enum": [
            "lexical_primary",
            "lexical_secondary",
            "hybrid_primary",
            "hybrid_secondary"
          ]
        },
        "mode": { "enum": ["lexical", "hybrid"] },
        "before_hits": { "type": "integer", "minimum": 1, "maximum": 100 },
        "after_hits": { "type": "integer", "minimum": 1, "maximum": 100 },
        "ranked_ids_identical": { "const": true },
        "score_components_exact": { "const": true },
        "metadata_exact": { "const": true }
      }
    },
    "recall_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "before_calls",
        "after_calls",
        "score_comparison",
        "score_tolerance",
        "all_rankings_identical",
        "all_score_components_exact",
        "all_metadata_exact",
        "retrieval_projection_proved"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/recall_case" }
        },
        "before_calls": { "const": 4 },
        "after_calls": { "const": 4 },
        "score_comparison": { "const": "exact" },
        "score_tolerance": { "const": 0 },
        "all_rankings_identical": { "const": true },
        "all_score_components_exact": { "const": true },
        "all_metadata_exact": { "const": true },
        "retrieval_projection_proved": { "const": true }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recall_calls",
        "sensitive_broad_redacted",
        "sensitive_exact_owner_visible",
        "cross_agent_isolated",
        "cross_account_isolated"
      ],
      "properties": {
        "recall_calls": { "const": 4 },
        "sensitive_broad_redacted": { "const": true },
        "sensitive_exact_owner_visible": { "const": true },
        "cross_agent_isolated": { "const": true },
        "cross_account_isolated": { "const": true }
      }
    },
    "cardinality_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_count",
        "manifest_format_version",
        "manifest_schema_version",
        "manifest_purpose",
        "manifest_status",
        "archive_bytes",
        "chunk_bytes",
        "manifest_tables",
        "non_empty_tables",
        "chunk_count",
        "exported_rows",
        "verified_rows",
        "imported_rows",
        "table_rows",
        "focal_counts",
        "recall_equivalence",
        "safety",
        "checksums_read",
        "all_chunks_verified",
        "all_tables_verified",
        "account_removed_before_import",
        "same_store_round_trip",
        "exact_table_row_counts",
        "exact_fixture_counts"
      ],
      "properties": {
        "memory_count": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "manifest_format_version": { "const": 1 },
        "manifest_schema_version": { "type": "integer", "minimum": 1 },
        "manifest_purpose": { "const": "self" },
        "manifest_status": { "const": "suspended" },
        "archive_bytes": { "type": "integer", "minimum": 1 },
        "chunk_bytes": { "type": "integer", "minimum": 1 },
        "manifest_tables": { "const": 74 },
        "non_empty_tables": { "type": "integer", "minimum": 1, "maximum": 256 },
        "chunk_count": { "type": "integer", "minimum": 1 },
        "exported_rows": { "type": "integer", "minimum": 1 },
        "verified_rows": { "type": "integer", "minimum": 1 },
        "imported_rows": { "type": "integer", "minimum": 1 },
        "table_rows": {
          "type": "array",
          "minItems": 74,
          "maxItems": 74,
          "items": { "$ref": "#/$defs/table_rows" }
        },
        "focal_counts": { "$ref": "#/$defs/focal_counts" },
        "recall_equivalence": { "$ref": "#/$defs/recall_equivalence" },
        "safety": { "$ref": "#/$defs/safety" },
        "checksums_read": { "const": true },
        "all_chunks_verified": { "const": true },
        "all_tables_verified": { "const": true },
        "account_removed_before_import": { "const": true },
        "same_store_round_trip": { "const": true },
        "exact_table_row_counts": { "const": true },
        "exact_fixture_counts": { "const": true }
      }
    },
    "vector_portability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector_profiles_portable",
        "memory_vectors_portable",
        "hybrid_equivalence_exercised",
        "vector_portability_limited",
        "vector_profiles_round_tripped",
        "memory_vectors_round_tripped"
      ],
      "properties": {
        "vector_profiles_portable": { "const": true },
        "memory_vectors_portable": { "const": true },
        "hybrid_equivalence_exercised": { "const": true },
        "vector_portability_limited": { "const": false },
        "vector_profiles_round_tripped": { "const": true },
        "memory_vectors_round_tripped": { "const": true }
      }
    }
  }
}
