cell:
  name: {{.Name}}
  cloud: {{.Cloud}}
  accountAlias: {{.AccountAlias}}
  region: {{.Region}}
  role: {{.Role}}
  domain: {{.Domain}}
  apiHost: {{.APIHost}}
gitops:
  repoURL: {{.RepoURL}}
  targetRevision: {{.TargetRevision}}
apps:
  witselfServer:
    enabled: true
    namespace: witself
    chartVersion: {{.ChartVersion}}
    imageTag: {{.ImageTag}}
    backendKind: managed
    awsAlbIngress:
      enabled: false
    gcpIngress:
      enabled: false
    azureGateway:
      # Pulumi enables this at runtime after enabling the AKS-managed ALB
      # Controller add-on and injecting the delegated association subnet ID.
      enabled: false
      albNamespace: azure-alb-system
      albName: witself-api
      gatewayName: witself-api
      https:
        enabled: true
        certificate:
          enabled: true
          secretName: witself-api-tls
          issuerRef:
            kind: ClusterIssuer
            name: letsencrypt-prod
          acme:
            enabled: true
            email: {{.ACMEEmail}}
            server: https://acme-v02.api.letsencrypt.org/directory
            privateKeySecretName: letsencrypt-prod-private-key
            solver: dns01
    secrets:
      bootstrap:
        enabled: true
        remoteKey: bootstrap-operator-token
        targetName: witself-bootstrap
        tokenKey: token
        ttlKey: ttl
        refreshInterval: 1h
        storeName: azure
      database:
        enabled: true
        remoteKey: db
        targetName: witself-db
        urlKey: dsn
        refreshInterval: 1h
        storeName: azure
      provision:
        enabled: true
        remoteKey: provision-token
        targetName: witself-provision
        tokenKey: token
        refreshInterval: 1h
        storeName: azure
platform:
  awsAlbIngress:
    enabled: false
  certManager:
    enabled: true
    chartVersion: {{.CertManagerChartVersion}}
    namespace: cert-manager
    enableGatewayAPI: true
    ignoreWebhookConfigurationDifferences: true
  externalDNS:
    # Pulumi enables this at runtime after creating Azure DNS, the managed
    # identity, and the azure.json config Secret values for the live cell.
    enabled: false
    chartVersion: {{.ExternalDNSChartVersion}}
    namespace: external-dns
    serviceAccountName: external-dns
    sources:
      - ingress
      - gateway-httproute
    domainFilters:
      - {{.Domain}}
    txtOwnerId: {{.Name}}
    provider:
      name: azure
  externalSecrets:
    enabled: true
    chartVersion: {{.ExternalSecretsChartVersion}}
    namespace: external-secrets
    storeName: azure
    serviceAccountName: external-secrets
    podLabels:
      azure.workload.identity/use: "true"
    # Pulumi injects the live Azure Key Vault URL and workload identity
    # annotations into the bootstrap Application for each provisioned cell.
  keda:
    enabled: true
    chartVersion: {{.KEDAChartVersion}}
    namespace: keda
    ignoreWebhookConfigurationDifferences: true
  metricsServer:
    enabled: false
    chartVersion: {{.MetricsServerChartVersion}}
    namespace: kube-system
    replicas: 1
