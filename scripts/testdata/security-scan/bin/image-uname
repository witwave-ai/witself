#!/bin/bash
set -eu
printf '%s|%s\n' "$PWD" "$*" >> "$SECURITY_SCAN_CASE/uname.argv"
printf '%s|%s|%s\n' "$GOPROXY" "${https_proxy:?}" "${npm_config_offline:?}" >> "$SECURITY_SCAN_CASE/env.log"
case "$1" in
  -s) if [ -f "$SECURITY_SCAN_CASE/uname.os" ]; then cat "$SECURITY_SCAN_CASE/uname.os"; else printf 'Linux\n'; fi ;;
  -m) if [ -f "$SECURITY_SCAN_CASE/uname.arch" ]; then cat "$SECURITY_SCAN_CASE/uname.arch"; else printf 'x86_64\n'; fi ;;
  *) exit 97 ;;
esac
