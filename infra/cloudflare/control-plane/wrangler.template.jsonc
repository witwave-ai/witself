// Cloudflare deployment of witself-control-plane: a thin Worker front door +
// the Go container (Cloudflare Containers, DO-addressed). One deployment, one
// domain: self.witwave.ai.
//
// Architecture notes (from the 2026-07 scaling research):
// - Containers do NOT autoscale; each instance is DO-fronted (~1k rps cap).
//   Fine for the cold path (signup/webhooks/registry). The future hot path
//   (account->cell directory reads) must be answered IN this Worker from a KV
//   binding and never reach the container.
// - Deploy only through `npm ci && npm run deploy`. The renderer requires a
//   clean, exactly tagged checkout and injects immutable release metadata into
//   the container build before Wrangler runs.
{
  "name": "witself-control-plane",
  "main": "src/index.js",
  "secrets": {
    "required": [
      "AGENT_EMAIL_ROUTE_ED25519_PRIVATE_KEY",
      "CONTROL_PLANE_EDGE_TOKEN"
    ]
  },
  "compatibility_date": "2026-06-01",
  // Evacuation validates each completed R2 archive by streaming the full
  // gzip/tar payload through native decompression and SHA-256 before routing
  // changes. Containers require Workers Paid, where authenticated HTTP
  // maintenance requests can use the 5-minute maximum instead of the
  // 30-second default; this is a ceiling, not reserved CPU.
  "limits": {
    "cpu_ms": 300000
  },
  "containers": [
    {
      // Explicit application name — wrangler otherwise derives
      // "<worker>-<class>" = "witself-control-plane-controlplane" (stutter).
      "name": "witself-control-plane",
      "class_name": "Backend",
      "image": "../../../images/witself-control-plane/Dockerfile",
      "image_build_context": "../../..",
      "image_vars": {
        "VERSION": "__WITSELF_VERSION__",
        "COMMIT": "__WITSELF_COMMIT__",
        "DATE": "__WITSELF_DATE__"
      },
      "instance_type": "lite",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROL_PLANE",
        "class_name": "Backend"
      },
      {
        "name": "ACCOUNT_LIFECYCLE",
        "class_name": "AccountLifecycle"
      },
      {
        "name": "CELL_COORDINATOR",
        "class_name": "TargetCellCoordinator"
      },
      {
        "name": "ACCOUNT_SIGNUP",
        "class_name": "AccountSignup"
      },
      {
        "name": "ACCOUNT_BACKUP",
        "class_name": "AccountBackup"
      },
      {
        "name": "REALM_EMAIL_ALIASES",
        "class_name": "RealmEmailAliasRegistry"
      },
      {
        "name": "AGENT_EMAIL_DOMAINS",
        "class_name": "AgentEmailDomainRegistry"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DIRECTORY",
      "id": "ec620d5131524e138a9fca6207953cd2"
    },
    {
      // Same dedicated namespace consumed by the agent-email Worker. It must
      // never be replaced with the broad account/cell DIRECTORY binding.
      "binding": "AGENT_EMAIL_DIRECTORY",
      "id": "__EMAIL_DIRECTORY_KV_ID__"
    }
  ],
  "vars": {
    // Immutable outer-Worker release identity. Cloudflare versions expose
    // these plain-text bindings, allowing an authenticated verifier to prove
    // the exact Worker version serving production traffic without relying on
    // the separately rolled container's public version response.
    "WITSELF_EDGE_RELEASE_VERSION": "__WITSELF_EDGE_RELEASE_VERSION__",
    "WITSELF_EDGE_RELEASE_COMMIT": "__WITSELF_EDGE_RELEASE_COMMIT__",
    "WITSELF_EDGE_RELEASE_DATE": "__WITSELF_EDGE_RELEASE_DATE__",
    "AGENT_EMAIL_ROUTE_SIGNING_KEY_ID": "__AGENT_EMAIL_ROUTE_SIGNING_KEY_ID__",
    // New aliases are assigned only on the permanent primary domain. The
    // bounded legacy set keeps already-issued canonical pilot addresses
    // routable while their domain-qualified authority is retired naturally.
    "AGENT_EMAIL_DOMAIN": "witmail.net",
    "AGENT_EMAIL_LEGACY_DOMAINS": "agent-mail.witwave.ai",
    // Exact, sorted account IDs only. Empty is the committed dark default;
    // canonical and managed-alias delivery also retain their independent
    // runtime gates. The email edge must receive the identical cohort bytes.
    "CP_AGENT_EMAIL_MANAGED_DELIVERY_ACCOUNT_ALLOWLIST": "__CP_AGENT_EMAIL_MANAGED_DELIVERY_ACCOUNT_ALLOWLIST__",
    // Independent technical queue ceilings. Plans, including explicit
    // unlimited overrides, cannot raise these values; a deployment may only
    // lower them below the compiled 8-per-realm / 64-per-account maxima.
    "CP_REALM_EMAIL_ALIAS_MAX_PENDING_PER_REALM": "8",
    "CP_REALM_EMAIL_ALIAS_MAX_PENDING_PER_ACCOUNT": "64",
    // This is a plan-independent abuse ceiling for pending customer-domain
    // ownership work. A deployment may lower it but never raise it above the
    // compiled limit, including for an account with an unlimited override.
    "CP_AGENT_EMAIL_CUSTOM_DOMAIN_MAX_OPEN_PER_ACCOUNT": "8"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ControlPlane"]
    },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "ControlPlane", "to": "Backend" }]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountLifecycle"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["TargetCellCoordinator"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["AccountSignup"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["AccountBackup"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["RealmEmailAliasRegistry"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["AgentEmailDomainRegistry"]
    }
  ],
  "routes": [
    {
      "pattern": "self.witwave.ai",
      "custom_domain": true
    }
  ],
  // Fleet maintenance tick. The pending-account reaper and placement runner
  // keep their own opt-in gates. Plan lifecycle also no-ops unless its explicit
  // runtime gate and private bridge credential are configured; when enabled it
  // wakes the scale-to-zero Go container for one bounded, KV-cursor-backed page.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Periodic account backups are an additive opt-in. The binding is
  // intentionally absent from the committed deployment config, which the
  // runtime treats as false. After a manual backup and restore drill pass,
  // activate it as a Worker secret so later code deployments preserve the
  // operator-controlled state. Further interval/page/concurrency/retry
  // settings have conservative runtime defaults and may also be supplied as
  // secrets during a controlled activation.
  // Verification email dispatch (Cloudflare Email Service, public beta).
  // Requires Workers Paid + witwave.ai enabled as a sending domain; the
  // Worker degrades gracefully (signup still succeeds) if sending fails.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Account archives from cell evacuations. Bucket lives on Cloudflare;
  // cells never see R2 credentials — the Worker streams from cell to R2
  // (multipart, so bounded memory regardless of account size).
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "witself-archives"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "witself-backups"
    },
    {
      // Create-only, hash-chained portability boundary for the global realm
      // email alias authority. Keep this bucket private and separate from
      // mutable account archives and periodic cell backups.
      "binding": "REALM_EMAIL_ALIAS_AUTHORITY_JOURNAL",
      "bucket_name": "witself-realm-email-alias-authority-journal"
    },
    {
      // Independent create-only, hash-chained portability boundary for the
      // global customer-owned agent-email domain authority. It is deliberately
      // not shared with managed aliases, account archives, or cell backups.
      "binding": "AGENT_EMAIL_DOMAIN_AUTHORITY_JOURNAL",
      "bucket_name": "witself-agent-email-domain-authority-journal"
    }
  ],
  // Edge rate limiter for the recovery endpoint (issue #23). Enforced at
  // the Cloudflare edge BEFORE the request reaches the Worker — so a
  // concurrent burst (curl -P N) is blocked by the platform instead of
  // racing the KV read-modify-write. The Worker's per-IP KV counter
  // (#14 partial fix) still guards the longer-term 4h quota; this
  // binding just prevents the burst that defeats the KV race. Keyed
  // per (IP, account) in the caller so an attacker who rotates
  // account_ids doesn't reset it.
  //
  // Namespace_id is an arbitrary integer that identifies the limiter
  // instance (not a Cloudflare-side id). Limit is deliberately very
  // tight (1 per 10s) because legitimate owners always wait ≥2 min
  // between attempts (the KV cooldown check enforces that) — the
  // edge limiter's only job is to shield the KV RMW from concurrent
  // bursts. Live probes show Cloudflare's rate limit binding is not
  // strictly atomic across concurrent requests hitting one edge PoP;
  // a small burst can leak. Tighter limits shrink that leak.
  "unsafe": {
    "bindings": [
      {
        "name": "RECOVER_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 1,
          "period": 10
        }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
  // Runtime-only Worker secrets used by the Go plan lifecycle are deliberately
  // absent from this file. Render the release config first, then configure them
  // with `npm run secret:put -- NAME`:
  // INTERNAL_BRIDGE_TOKEN (required), CONTROL_PLANE_EDGE_TOKEN (must exactly
  // match the agent-email Worker's secret),
  // CP_REALM_EMAIL_ALIAS_ACTIVATION_ENABLED=true (only after catch-all,
  // canonical backfill/realm retirement, account lifecycle, terminal recovery,
  // and the Email Worker's independent alias-delivery gate pass acceptance;
  // the account must also be present in the exact managed-delivery cohort,
  // see docs/agent-email.md), CP_REALM_EMAIL_CANONICAL_INVENTORY_ENABLED=true
  // and CP_REALM_EMAIL_CANONICAL_DELIVERY_ENABLED=true (only during their
  // separately reviewed staged activation), CP_REALM_EMAIL_ALIAS_RECOVERY_TOKEN (distinct
  // second credential for empty-target recovery only),
  // CP_AGENT_EMAIL_CUSTOM_DOMAIN_REQUESTS_ENABLED=true (must remain absent
  // until the external-DNS lane, capacity/admission, bounded-audit, durable
  // plan-recovery, routing/projection, and delivery blockers are accepted),
  // CP_AGENT_EMAIL_CUSTOM_DOMAIN_REQUEST_ACCOUNT_ALLOWLIST=acct_... (required
  // with the request gate; there is intentionally no wildcard),
  // CP_AGENT_EMAIL_CUSTOM_DOMAIN_AUTHORITY_READY=true (required only after the
  // exact journal head and a named sealed recovery drill are independently
  // verified), CP_AGENT_EMAIL_CUSTOM_DOMAIN_VERIFICATION_ENABLED=true (a
  // separate admin/worker DNS-observation gate; it never authorizes routing or
  // mail delivery),
  // CP_AGENT_EMAIL_DOMAIN_AUTHORITY_JOURNAL_ENABLED=true (only after the
  // existing registry completes a bounded bootstrap and an empty-target
  // recovery drill), CP_AGENT_EMAIL_DOMAIN_RECOVERY_TOKEN (a distinct second
  // credential used only by journal and empty-target recovery administration),
  // CP_PLAN_LIFECYCLE_ENABLED=true (only
  // when intentionally activating lifecycle), CP_R2_ENDPOINT, CP_R2_BUCKET,
  // CP_R2_ACCESS_KEY, CP_R2_SECRET_KEY, and optionally CP_R2_PREFIX. To enable
  // Stripe, also set CP_BILLING_PROVIDER=stripe, CP_STRIPE_SECRET_KEY, and
  // CP_STRIPE_WEBHOOK_SECRET; CP_STRIPE_SUCCESS_URL and CP_STRIPE_CANCEL_URL
  // are optional. The Backend class explicitly maps only these bindings to
  // WITSELF_CP_* container env vars; the ARCHIVES R2 binding itself remains
  // Worker-only.
}
