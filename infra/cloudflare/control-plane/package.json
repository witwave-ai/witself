{
  "name": "witself-control-plane-deploy",
  "private": true,
  "description": "Cloudflare Worker + Container deployment for witself-control-plane",
  "scripts": {
    "activate:plan-lifecycle": "node scripts/activate-plan-lifecycle.mjs",
    "assert:custom-domain-dark": "node scripts/assert-custom-domain-dark.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "config": "node scripts/render-wrangler.mjs",
    "deploy": "node scripts/deploy-release.mjs",
    "deploy:plans": "npm run config && wrangler deploy --config ../../../web/plans/wrangler.toml",
    "deploy:legal": "npm run config && wrangler deploy --config ../../../web/legal/wrangler.toml",
    "dev": "wrangler dev --config wrangler.template.jsonc",
    "secret:put:break-glass": "npm run config && wrangler secret put --config wrangler.generated.jsonc",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  }
}
