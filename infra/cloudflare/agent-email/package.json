    "provision:route-signing-secrets": "node scripts/provision-route-signing-secrets.mjs",
    "rollback": "node scripts/rollback.mjs",
    "routing:foundation": "node scripts/routing-foundation.mjs",
    "routes": "node scripts/routes.mjs",
    "routes:catch-all": "node scripts/catch-all-routes.mjs",
    "routes:primary": "node scripts/primary-routes.mjs",
    "storage-probe": "node scripts/storage-probe.mjs",
    "test": "node --test test/*.test.mjs && go run ./test/golden-go ./test/golden-vector.json",
