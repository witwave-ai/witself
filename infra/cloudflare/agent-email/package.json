{
  "name": "witself-agent-email-receive-edge",
  "private": true,
  "type": "module",
  "description": "Production Cloudflare Email Worker for Witself inbound agent email",
  "scripts": {
    "assert:custom-domain-dark": "node scripts/assert-custom-domain-dark.mjs",
    "assert:release-source": "node scripts/assert-release-source.mjs",
    "bootstrap:production-receive": "node scripts/bootstrap-production-receive.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "canary": "node scripts/canary.mjs",
    "gates:canonical": "node scripts/canonical-gates.mjs",
    "config": "node scripts/render-wrangler.mjs",
    "deploy": "node scripts/deploy.mjs",
    "directory": "node scripts/directory.mjs",
    "large-payload-probe": "node scripts/near-limit-probe.mjs",
    "metrics": "node scripts/metrics.mjs",
    "near-limit-probe": "node scripts/near-limit-probe.mjs",
