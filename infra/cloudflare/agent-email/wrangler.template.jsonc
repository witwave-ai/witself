// This is intentionally a separate email-only Worker. It has no HTTP route,
// no control-plane Container binding, and no binding to the control plane's
// DIRECTORY namespace. Its bounded stale-route fallback uses the authenticated
// public control-plane URL. Generate wrangler.generated.jsonc with `npm run config`.
{
  "name": "witself-agent-email-receive",
  "main": "src/index.js",
  "secrets": {
    "required": [
      "CONTROL_PLANE_EDGE_TOKEN",
      "RELAY_ED25519_PRIVATE_KEY"
    ]
  },
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "EMAIL_DIRECTORY",
      "id": "__EMAIL_DIRECTORY_KV_ID__"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EMAIL_EDGE_METRICS",
      "dataset": "witself_agent_email_edge"
    }
  ],
  "ratelimits": [
    {
      "name": "REALM_ROUTE_COLD_MISS_LIMITER",
      "namespace_id": "2201",
      "simple": {
        "limit": 10,
        "period": 10
      }
    },
    {
      "name": "REALM_ROUTE_KNOWN_MISS_LIMITER",
      "namespace_id": "2202",
      "simple": {
        "limit": 100,
        "period": 10
      }
    }
  ],
  "vars": {
    "AGENT_EMAIL_DOMAIN": "witmail.net",
    "AGENT_EMAIL_LEGACY_DOMAINS": "agent-mail.witwave.ai",
    "RELAY_KEY_ID": "__RELAY_KEY_ID__",
    "CONTROL_PLANE_URL": "__CONTROL_PLANE_URL__",
    "AGENT_EMAIL_ROUTE_ED25519_PUBLIC_KEYS": __AGENT_EMAIL_ROUTE_ED25519_PUBLIC_KEYS__,
    // Must be the exact canonical account cohort configured on the control
    // plane. Empty is default-off and there is deliberately no wildcard.
    "AGENT_EMAIL_MANAGED_DELIVERY_ACCOUNT_ALLOWLIST": "__AGENT_EMAIL_MANAGED_DELIVERY_ACCOUNT_ALLOWLIST__",
    "WITSELF_EDGE_RELEASE_VERSION": "__WITSELF_EDGE_RELEASE_VERSION__",
    "WITSELF_EDGE_RELEASE_COMMIT": "__WITSELF_EDGE_RELEASE_COMMIT__",
    "WITSELF_EDGE_RELEASE_DATE": "__WITSELF_EDGE_RELEASE_DATE__",
    "REALM_EMAIL_ALIAS_DELIVERY_ENABLED": "__REALM_EMAIL_ALIAS_DELIVERY_ENABLED__",
    "REALM_EMAIL_CANONICAL_DELIVERY_ENABLED": "__REALM_EMAIL_CANONICAL_DELIVERY_ENABLED__",
    "AGENT_EMAIL_DMARC_REJECT_ENABLED": "__AGENT_EMAIL_DMARC_REJECT_ENABLED__",
    "AGENT_EMAIL_AUTH_RESULTS_AUTHSERV_ID": __AGENT_EMAIL_AUTH_RESULTS_AUTHSERV_ID__
  },
  "observability": {
    "enabled": true
  }
}
