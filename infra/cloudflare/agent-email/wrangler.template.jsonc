// This is intentionally a separate email-only Worker. It has no HTTP route,
// no control-plane Container binding, and no binding to the control plane's
// DIRECTORY namespace. Its bounded stale-route fallback uses the authenticated
// public control-plane URL. Generate wrangler.generated.jsonc with `npm run config`.
{
  "name": "witself-agent-email-pilot",
  "main": "src/index.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "EMAIL_DIRECTORY",
      "id": "__EMAIL_DIRECTORY_KV_ID__"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EMAIL_EDGE_METRICS",
      "dataset": "witself_agent_email_edge"
    }
  ],
  "ratelimits": [
    {
      "name": "REALM_ROUTE_COLD_MISS_LIMITER",
      "namespace_id": "2201",
      "simple": {
        "limit": 10,
        "period": 10
      }
    },
    {
      "name": "REALM_ROUTE_KNOWN_MISS_LIMITER",
      "namespace_id": "2202",
      "simple": {
        "limit": 100,
        "period": 10
      }
    }
  ],
  "vars": {
    "RELAY_KEY_ID": "__RELAY_KEY_ID__",
    "CONTROL_PLANE_URL": "__CONTROL_PLANE_URL__",
    "REALM_EMAIL_ALIAS_DELIVERY_ENABLED": "__REALM_EMAIL_ALIAS_DELIVERY_ENABLED__"
  },
  "observability": {
    "enabled": true
  }
}
