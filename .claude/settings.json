{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__codex-local__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/codex-ceiling-guard.mjs",
              "--deny-only"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
